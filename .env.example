# Match these values to `id -u` and `id -g` on the Docker host.
HOST_UID=1000
HOST_GID=1000

# Proof-of-concept area used by the one-shot QGIS data-preparation service.
TERRAIN_AREA_NAME=Macizo del Ida, Creta
TERRAIN_BBOX=24.60,35.10,24.96,35.35

# Copernicus terrain request limits; checked before downloads and processing.
TERRAIN_MAX_TILES=16
TERRAIN_MAX_SPAN_DEGREES=4
TERRAIN_MAX_RASTER_PIXELS=30000000
TERRAIN_JOB_TIMEOUT_SECONDS=1800
